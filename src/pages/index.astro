---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseList from '../components/CaseList.astro';
import NewsletterBox from '../components/NewsletterBox.astro';

const allCases = (await getCollection('cases')).sort((a, b) => {
  const dateDiff = b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  if (dateDiff !== 0) return dateDiff;
  return b.data.caseId.localeCompare(a.data.caseId);
});

const allClues = (await getCollection('clues')).sort((a, b) => {
  const byDate = b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  if (byDate !== 0) return byDate;
  return b.data.order - a.data.order;
});
const topClues = allClues.slice(0, 4);

// 供客户端脚本使用：slug + title
const caseIndex = allCases.map((c) => ({ slug: c.id, title: c.data.title }));

const featuredCases = allCases.filter((c) => c.data.featured);
const showcase = featuredCases.length ? featuredCases : allCases;
const showcaseCount = showcase.length;
const latest = showcase.slice(0, 10).map((c) => ({
  caseId: c.data.caseId,
  title: c.data.title,
  summary: c.data.summary,
  difficulty: c.data.difficulty,
  types: c.data.types,
  readingTime: c.data.readingTime,
  status: c.data.status,
  slug: c.id,
}));

const steps = [
  {
    n: '壹',
    code: '01',
    title: '查阅卷宗',
    body: '细读案发现场、涉案人物关系与各方时间线陈述。',
  },
  {
    n: '贰',
    code: '02',
    title: '识破矛盾',
    body: '为七件现场物证贴上重要、可疑或误导标签，抓住证词破绽。',
  },
  {
    n: '叁',
    code: '03',
    title: '落笔定案',
    body: '在拆封真相前完成三道推演裁决，检验你的推理链。',
  },
];

const caseTypes = [
  { label: '密室', desc: '门窗反锁，凶手却已离开现场。' },
  { label: '不在场证明', desc: '每个人都声称案发时身在别处。' },
  { label: '时间诡计', desc: '真相藏在事件顺序、刻度与历法错位里。' },
  { label: '证词矛盾', desc: '有人无意间多说了一个不该知道的细节。' },
  { label: '叙述性诡计', desc: '你读到的陈述，未必是事情的全貌。' },
  { label: '物证误导', desc: '最显眼的线索，往往是凶手布下的红鲱鱼。' },
];
---

<BaseLayout
  title="推知｜原创本格互动推理案卷馆"
  description="推知是一个纯中文原创公平本格互动推理网站。真相从不明说，只能被推断——查阅人物与证词，标记现场物证，在拆封答案前完成你的推断。"
  path="/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '推知',
    alternateName: '推知 Inferred',
    description: '原创公平本格互动推理小说与侦探解谜案卷馆——涵盖密室悬案、不在场证明、时间诡计与证词矛盾，查阅线索并锁定真凶。',
    url: 'https://www.inferred.uk/',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://www.inferred.uk/search/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <!-- 第一幕：左文右台「侦探案头」首屏 -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">原创公平本格 · 馆藏 {allCases.length} 桩案卷 · 零剧透互动推演</p>
        <h1 class="hero__title">真相从不明说，<br />只能被推断。</h1>
        <p class="hero__subtitle">
          每一份卷宗都是一桩等待审视的本格推理谜案。比对彼此矛盾的证词与不在场证明，甄别密室现场真伪混杂的物证线索，在拆封真相之前锁定凶手、写下你的侦探裁决。
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/cases/">翻阅全部案卷 →</a>
          <a class="btn btn--ghost" href="/archive/">按难度与诡计调阅</a>
        </div>
      </div>

      <!-- 右侧侦探案头快速入口面板 -->
      <aside
        class="desk"
        data-case-index={JSON.stringify(caseIndex)}
        aria-label="侦探案头快速入口"
      >
        <header class="desk__head">
          <span class="desk__kicker mono">侦探案头 · 快速开卷</span>
          <div class="user-progress" data-user-progress data-total={allCases.length} hidden>
            <span class="user-progress__label mono" data-progress-label></span>
            <div class="user-progress__bar" aria-hidden="true">
              <div class="user-progress__fill" data-progress-fill></div>
            </div>
          </div>
        </header>

        <div class="desk__cards">
          <a class="qs-card qs-card--resume" href="#" data-qs-resume hidden>
            <span class="qs-card__tag mono">继续推理</span>
            <span class="qs-card__title" data-qs-resume-title>—</span>
            <span class="qs-card__arrow mono" aria-hidden="true">接着查 →</span>
          </a>
          <a class="qs-card qs-card--daily" href="#" data-qs-daily>
            <span class="qs-card__tag mono">今日推荐</span>
            <span class="qs-card__title" data-qs-daily-title>—</span>
            <span class="qs-card__arrow mono" aria-hidden="true">开卷 →</span>
          </a>
          <a class="qs-card qs-card--weekly" href="/weekly/">
            <span class="qs-card__tag mono">本周悬案</span>
            <span class="qs-card__title">每周一换的固定挑战</span>
            <span class="qs-card__arrow mono" aria-hidden="true">应战 →</span>
          </a>
          <button class="qs-card qs-card--random" type="button" data-qs-random>
            <span class="qs-card__tag mono">随机抽卷</span>
            <span class="qs-card__title">随缘抽一桩馆藏谜案</span>
            <span class="qs-card__arrow mono" aria-hidden="true">抽取 →</span>
          </button>
        </div>
      </aside>
    </div>
  </section>

  <!-- 第二幕：精选案卷双列档案 -->
  <section class="container section">
    <header class="section__head">
      <div>
        <p class="eyebrow">卷宗精选 · 共 {showcaseCount} 份</p>
        <h2 class="section__title">精选案卷</h2>
      </div>
      <a class="section__more" href="/cases/">查看全部 {allCases.length} 份案卷 →</a>
    </header>
    <CaseList cases={latest} />
  </section>

  <!-- 第三幕：三步推演法则 -->
  <section class="how">
    <div class="container">
      <header class="section__head">
        <div>
          <p class="eyebrow">推演守则 · 公平本格</p>
          <h2 class="section__title">三步，从蛛丝马迹到水落石出</h2>
        </div>
      </header>
      <ol class="how__steps">
        {
          steps.map((s) => (
            <li class="how__step">
              <div class="how__badge">
                <span class="how__han">{s.n}</span>
                <span class="how__num mono">{s.code}</span>
              </div>
              <h3 class="how__step-title">{s.title}</h3>
              <p class="how__step-body text-muted">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 第四幕：诡计门类 + 推理技法专栏（均衡双区） -->
  <section class="container section">
    <div class="catalog-grid">
      <div>
        <header class="section__head">
          <div>
            <p class="eyebrow">诡计门类</p>
            <h2 class="section__title">按作案手法调阅</h2>
          </div>
          <a class="section__more" href="/archive/">进入档案馆 →</a>
        </header>
        <ul class="types">
          {
            caseTypes.map((t) => (
              <li class="types__item">
                <a class="types__link" href={`/archive/?type=${encodeURIComponent(t.label)}`}>
                  <span class="types__label">{t.label}</span>
                  <span class="types__desc text-muted">{t.desc}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="clues-panel" aria-labelledby="home-clues-title">
        <header class="section__head">
          <div>
            <p class="eyebrow">推理技法专栏</p>
            <h2 class="section__title" id="home-clues-title">读案手记</h2>
          </div>
          <a class="section__more" href="/clues/">全部手记 →</a>
        </header>
        <ul class="clues-panel__list">
          {
            topClues.map((a) => (
              <li>
                <a class="clues-panel__item" href={`/clues/${a.id}/`}>
                  <h3 class="clues-panel__title">{a.data.title}</h3>
                  <p class="clues-panel__desc text-muted">{a.data.summary}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- 第五幕：RSS 订阅 -->
  <section class="container section">
    <NewsletterBox />
  </section>
</BaseLayout>

<style>
  /* 首屏双栏：左文右台 */
  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-line);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-surface) 65%, var(--color-bg)),
      var(--color-bg)
    );
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .hero__title {
    font-size: clamp(2.2rem, 5.2vw, 3.55rem);
    line-height: 1.16;
    margin: var(--space-4) 0 var(--space-5);
    letter-spacing: 0.02em;
  }
  .hero__subtitle {
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    color: var(--color-muted);
    max-width: 34rem;
    line-height: 1.8;
    margin: 0 0 var(--space-6);
  }
  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* 侦探案头面板 */
  .desk {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
  }
  .desk__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  .desk__kicker {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-gold);
  }
  .desk__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .qs-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: inherit;
    cursor: pointer;
    text-align: left;
    font: inherit;
    text-decoration: none;
    min-height: 6.4rem;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }
  .qs-card:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-2);
    color: inherit;
    transform: translateY(-1px);
  }
  .qs-card__tag {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .qs-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-paper);
    flex: 1;
    line-height: 1.45;
  }
  .qs-card__arrow {
    font-size: 0.75rem;
    color: var(--color-accent);
    align-self: flex-end;
  }
  .qs-card--resume {
    grid-column: 1 / -1;
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-bg));
    min-height: 0;
  }
  .qs-card--resume .qs-card__tag {
    color: var(--color-accent);
    font-weight: 600;
  }
  .qs-card--daily .qs-card__tag {
    color: var(--color-gold);
  }
  .desk__cards:not(:has(.qs-card--resume:not([hidden]))) .qs-card--random {
    grid-column: 1 / -1;
    min-height: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .desk__cards:not(:has(.qs-card--resume:not([hidden]))) .qs-card--random .qs-card__title {
    flex: 1;
    margin-inline: var(--space-3);
  }
  .desk__cards:not(:has(.qs-card--resume:not([hidden]))) .qs-card--random .qs-card__arrow {
    align-self: center;
  }

  /* 个人破案进度条 */
  .user-progress {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .user-progress__label {
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  .user-progress__bar {
    width: 4.5rem;
    height: 4px;
    background: var(--color-line);
    border-radius: 99px;
    overflow: hidden;
  }
  .user-progress__fill {
    height: 100%;
    width: 0%;
    background: var(--color-good);
    border-radius: 99px;
    transition: width 0.4s ease;
  }

  /* 通用区块 */
  .section {
    padding-block: var(--space-12);
  }
  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }
  .section__title {
    margin: var(--space-1) 0 0;
  }
  .section__more {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--color-gold);
    white-space: nowrap;
  }
  .section__more:hover {
    color: var(--color-accent);
  }

  /* 三步推演守则 */
  .how {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-12);
  }
  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .how__step {
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-top: 2px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .how__badge {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .how__han {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-accent);
  }
  .how__num {
    font-size: 0.76rem;
    color: var(--color-muted);
  }
  .how__step-title {
    margin: var(--space-2) 0 var(--space-2);
  }
  .how__step-body {
    margin: 0;
    font-size: 0.94rem;
  }

  /* 诡计门类 + 推理手记双区 */
  .catalog-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .types {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .types__item {
    display: flex;
  }
  .types__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: inherit;
    width: 100%;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }
  .types__link:hover {
    color: inherit;
    border-color: var(--color-accent);
    background: var(--color-surface-2);
    transform: translateY(-1px);
  }
  .types__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--color-paper);
  }
  .types__desc {
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .clues-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .clues-panel__item {
    display: block;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius);
    color: inherit;
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }
  .clues-panel__item:hover {
    color: inherit;
    border-color: var(--color-accent);
    background: var(--color-surface-2);
  }
  .clues-panel__title {
    margin: 0 0 var(--space-1);
    font-size: 1rem;
  }
  .clues-panel__desc {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 960px) {
    .hero__grid,
    .catalog-grid {
      grid-template-columns: 1fr;
    }
    .how__steps {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
  @media (max-width: 560px) {
    .desk__cards,
    .types {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline src="/quickstart.js" defer></script>

<script>
  const el = document.querySelector<HTMLElement>('[data-user-progress]');
  if (el) {
    const total = Number(el.dataset.total) || 0;
    let solved = 0;
    let reading = 0;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k?.startsWith('inferred:progress:')) {
          const v = localStorage.getItem(k);
          if (v === 'solved') solved++;
          else if (v === 'reading') reading++;
        }
      }
    } catch (_) {}
    if (solved > 0 || reading > 0) {
      el.removeAttribute('hidden');
      const label = el.querySelector('[data-progress-label]');
      const fill = el.querySelector<HTMLElement>('[data-progress-fill]');
      if (label) {
        label.textContent =
          solved > 0
            ? `已结案 ${solved}${reading > 0 ? ` · 推理中 ${reading}` : ''} / ${total}`
            : `推理中 ${reading} / ${total}`;
      }
      if (fill) {
        fill.style.width = `${Math.min(100, Math.round((solved / total) * 100))}%`;
      }
    }
  }
</script>
