---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseMeta from '../../components/CaseMeta.astro';
import Tag from '../../components/Tag.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ShareBar from '../../components/ShareBar.astro';
import HintSystem from '../../components/HintSystem.astro';
import DifficultyVote from '../../components/DifficultyVote.astro';
import RelatedCases from '../../components/RelatedCases.astro';
import CaseSummary from '../../components/CaseSummary.astro';

export const prerender = true;

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  const sorted = [...cases].sort(
    (a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime()
  );
  return sorted.map((entry, i) => {
    const related = cases
      .filter((c) => c.id !== entry.id)
      .map((c) => ({
        c,
        score: c.data.types.filter((t) => entry.data.types.includes(t)).length,
      }))
      .sort(
        (a, b) =>
          b.score - a.score || b.c.data.publishedAt.getTime() - a.c.data.publishedAt.getTime()
      )
      .slice(0, 3)
      .map(({ c }) => ({
        caseId: c.data.caseId,
        title: c.data.title,
        types: c.data.types,
        difficulty: c.data.difficulty,
        status: c.data.status,
        readingTime: c.data.readingTime,
        slug: c.id,
      }));

    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: i > 0 ? sorted[i - 1] : null,
        next: i < sorted.length - 1 ? sorted[i + 1] : null,
        related,
      },
    };
  });
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);
const sectionHeadings = headings.filter((h) => h.depth === 2);
const data = entry.data;

const seoTitle = `${data.title}｜卷宗第 ${data.caseId} 号 · 推知`;
const shareTitle = `${data.title} · 推知`;
const seoDesc = data.summary;
const shareImage = `/og/cases/${entry.id}.jpg`;
const shareImageAlt = `案卷 ${data.caseId}：${data.title}`;
const publishedIso = data.publishedAt.toISOString();
const dateStr = data.publishedAt.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const siteOrigin = Astro.site ?? 'https://www.inferred.uk';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.summary,
    datePublished: publishedIso,
    image: new URL(shareImage, siteOrigin).href,
    url: new URL(`/cases/${entry.id}/`, siteOrigin).href,
    author: { '@type': 'Organization', name: '推知 Inferred' },
    publisher: { '@type': 'Organization', name: '推知 Inferred' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', siteOrigin).href },
      { '@type': 'ListItem', position: 2, name: '案卷库', item: new URL('/cases/', siteOrigin).href },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  },
];
---

<BaseLayout
  title={seoTitle}
  ogTitle={shareTitle}
  description={seoDesc}
  path={`/cases/${entry.id}/`}
  ogImage={shareImage}
  ogImageAlt={shareImageAlt}
  ogType="article"
  publishedTime={publishedIso}
  jsonLd={jsonLd}
>
  <article
    class="case container"
    data-pagefind-body
    data-case-config={JSON.stringify({
      caseSlug: entry.id,
      siteStatus: data.status,
      caseQuestions: data.questions ?? null,
    })}
  >
    <ReadingProgress target="#case-body" />

    <div class="case__layout">
      <div class="case__main">
        <header class="case__header">
          <p
            class="eyebrow case__eyebrow"
            data-case-eyebrow
            data-case-slug={entry.id}
            data-site-status={data.status}
          >
            卷宗第 {data.caseId} 号 · <span data-case-eyebrow-text
              >{data.status === 'solved' ? '已解' : '未解'}</span
            >
          </p>
          <h1 class="case__title">{data.title}</h1>
          <p class="case__summary">{data.summary}</p>

          <ul class="case__tags">
            {
              data.types.map((t) => (
                <li>
                  <Tag label={t} href={`/archive/?type=${encodeURIComponent(t)}`} />
                </li>
              ))
            }
            {
              data.scene.map((s) => (
                <li>
                  <Tag label={s} variant="scene" href={`/archive/?scene=${encodeURIComponent(s)}`} />
                </li>
              ))
            }
          </ul>

          <div class="case__meta-mobile">
            <CaseMeta
              caseId={data.caseId}
              slug={entry.id}
              status={data.status}
              difficulty={data.difficulty}
              types={data.types}
              readingTime={data.readingTime}
              clueCount={data.clueCount}
            />
          </div>
          <p class="case__published mono text-muted">归档于 {dateStr}</p>
        </header>

        {
          data.hints && data.hints.length > 0 && (
            <div id="case-hints">
              <HintSystem hints={data.hints} />
            </div>
          )
        }

        <div id="case-body" class="case__body prose">
          <Content />
        </div>

        <CaseSummary />

        <DifficultyVote slug={entry.id} officialDifficulty={data.difficulty} />

        <ShareBar
          title={data.title}
          text={data.summary}
          path={`/cases/${entry.id}/`}
          poster={`/share/cases/${entry.id}.jpg`}
        />

        <RelatedCases cases={related} />

        <nav class="case__nav" aria-label="案卷导航">
          {
            prev ? (
              <a class="case__nav-link" href={`/cases/${prev.id}/`}>
                <span class="case__nav-dir mono">← 上一卷</span>
                <span class="case__nav-title">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a class="case__nav-link case__nav-link--next" href={`/cases/${next.id}/`}>
                <span class="case__nav-dir mono">下一卷 →</span>
                <span class="case__nav-title">{next.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>

        <footer class="case__footer">
          <a class="case__back" href="/cases/">← 返回案卷库</a>
          <a class="case__back" href="/archive/">进入档案馆筛选 →</a>
        </footer>
      </div>

      <!-- 宽屏右侧吸顶「卷宗导航台」 -->
      <aside class="case__aside" aria-label="卷宗档案与章节导航" data-pagefind-ignore>
        <div class="case__aside-card">
          <CaseMeta
            caseId={data.caseId}
            slug={entry.id}
            status={data.status}
            difficulty={data.difficulty}
            types={data.types}
            readingTime={data.readingTime}
            clueCount={data.clueCount}
          />
        </div>

        {
          sectionHeadings.length > 0 && (
            <nav class="case__toc" aria-label="卷宗章节跳转">
              <p class="case__toc-head mono">卷宗目录</p>
              <ol class="case__toc-list">
                {sectionHeadings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="case__toc-link" data-toc-link={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
              {data.hints && data.hints.length > 0 && (
                <a class="case__toc-hint mono" href="#case-hints">
                  查看锦囊提示（共 {data.hints.length} 条） ↑
                </a>
              )}
            </nav>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>

<script is:inline src="/case-progress.js"></script>

<script>
  // 将连续的涉案人物卡归入双列等高网格（.person-grid），消除 MDX 空白节点导致的宽度折行
  const body = document.getElementById('case-body');
  if (body) {
    const cards = Array.from(body.querySelectorAll<HTMLElement>(':scope > .person-card'));
    if (cards.length > 1) {
      let group: HTMLElement | null = null;
      cards.forEach((card) => {
        const prev = card.previousElementSibling;
        if (!group || prev !== group) {
          group = document.createElement('div');
          group.className = 'person-grid';
          card.parentNode?.insertBefore(group, card);
        }
        group.appendChild(card);
      });
    }
  }

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const targets = links
    .map((a) => {
      const id = a.dataset.tocLink;
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => Boolean(el));

  if (links.length > 0 && targets.length > 0 && 'IntersectionObserver' in window) {
    const activate = (id: string) => {
      links.forEach((a) => {
        a.classList.toggle('is-active', a.dataset.tocLink === id);
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) activate(visible[0].target.id);
      },
      { rootMargin: '-90px 0px -65% 0px', threshold: 0 }
    );
    targets.forEach((t) => observer.observe(t));
    activate(targets[0].id);
  }
</script>

<style>
  .case {
    padding-top: var(--space-12);
  }
  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 44rem) minmax(15.5rem, 18.5rem);
    justify-content: space-between;
    gap: var(--space-8);
    align-items: start;
  }
  .case__main {
    min-width: 0;
  }
  .case__header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
  }
  .case__eyebrow {
    margin-bottom: var(--space-3);
  }
  .case__title {
    margin-bottom: var(--space-4);
  }
  .case__summary {
    font-size: 1.12rem;
    line-height: 1.75;
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }
  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .case__meta-mobile {
    display: none;
    margin-bottom: var(--space-4);
  }
  .case__published {
    margin: var(--space-2) 0 0;
    font-size: 0.78rem;
  }

  /* 右侧吸顶卷宗台 */
  .case__aside {
    position: sticky;
    top: 5.2rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .case__toc {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--shadow-card);
  }
  .case__toc-head {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-gold);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-line);
  }
  .case__toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .case__toc-link {
    display: block;
    padding: 0.36rem 0.55rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--color-muted);
    border-left: 2px solid transparent;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .case__toc-link:hover {
    color: var(--color-paper);
    background: var(--color-surface-2);
  }
  .case__toc-link.is-active {
    color: var(--color-accent);
    font-weight: 700;
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }
  .case__toc-hint {
    display: block;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-line);
    font-size: 0.76rem;
    color: var(--color-gold);
  }
  .case__toc-hint:hover {
    color: var(--color-accent);
  }

  .case__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .case__nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-paper);
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }
  .case__nav-link:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-2);
    color: var(--color-paper);
  }
  .case__nav-link--next {
    text-align: right;
  }
  .case__nav-dir {
    font-size: 0.74rem;
    color: var(--color-muted);
  }
  .case__nav-title {
    font-weight: 600;
    font-size: 0.96rem;
    line-height: 1.45;
  }
  .case__footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .case__back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .case__back:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1040px) {
    .case__layout {
      display: block;
      max-width: var(--measure);
      margin-inline: auto;
    }
    .case__aside {
      display: none;
    }
    .case__meta-mobile {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .case__nav {
      grid-template-columns: 1fr;
    }
    .case__nav-link--next {
      text-align: left;
    }
  }
</style>

<style is:global>
  /* 案卷正文排版 */
  .prose h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-line);
  }
  .prose h2::before {
    content: '§ ';
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .prose h3 {
    color: var(--color-gold);
  }
  .prose ol,
  .prose ul {
    padding-left: 1.4em;
  }
  .prose li {
    margin-bottom: var(--space-2);
  }
  .prose blockquote {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-accent-cold);
    background: var(--color-surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--color-muted);
  }
  .prose strong {
    color: var(--color-paper);
  }

  /* 宽屏下连续的涉案人物卡（.person-grid）双列等高排布，一屏比对嫌疑人与不在场证明 */
  .person-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-4) 0;
  }
  .person-grid > .person-card {
    margin: 0;
    height: 100%;
  }
  @media (max-width: 720px) {
    .person-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
