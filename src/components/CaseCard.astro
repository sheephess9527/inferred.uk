---
import DifficultyStars from './DifficultyStars.astro';
import Tag from './Tag.astro';

export interface Props {
  caseId: string;
  title: string;
  summary: string;
  difficulty: number;
  types: string[];
  readingTime: string;
  status: 'unsolved' | 'solved';
  slug: string;
}
const { caseId, title, summary, difficulty, types, readingTime, status, slug } = Astro.props;
const href = `/cases/${slug}/`;
const statusCn = status === 'solved' ? '已解' : '未解';
---

<article class="case-card" data-case-slug={slug} data-site-status={status}>
  <a class="case-card__link" href={href} aria-label={`查阅案卷：${title}`}>
    <header class="case-card__head">
      <span class="case-card__id mono">卷宗第 {caseId} 号</span>
      <span class:list={['tag', `tag--status-${status}`]} data-progress-badge>{statusCn}</span>
    </header>

    <h3 class="case-card__title">{title}</h3>
    <p class="case-card__summary">{summary}</p>

    <ul class="case-card__types">
      {
        types.map((t) => (
          <li>
            <Tag label={t} />
          </li>
        ))
      }
    </ul>

    <footer class="case-card__foot">
      <DifficultyStars value={difficulty} />
      <span class="case-card__time mono">{readingTime}</span>
      <span class="case-card__cta mono">查阅卷宗 →</span>
    </footer>
  </a>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 13.5rem;
  }
  .case-card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    color: inherit;
    position: relative;
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }
  .case-card__link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent);
    opacity: 0.72;
    transition: opacity 0.2s ease, width 0.2s ease;
  }
  .case-card__link:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-2);
    box-shadow: var(--shadow-float);
    transform: translateY(-2px);
  }
  .case-card__link:hover::before {
    opacity: 1;
    width: 4px;
  }
  .case-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .case-card__id {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .case-card__title {
    font-family: var(--font-display);
    font-size: 1.28rem;
    margin: 0;
    color: var(--color-paper);
    line-height: 1.35;
  }
  .case-card__summary {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.72;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .case-card__types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }
  .case-card__foot {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-line);
    font-size: 0.85rem;
  }
  .case-card__time {
    color: var(--color-muted);
    font-size: 0.78rem;
  }
  .case-card__cta {
    margin-left: auto;
    color: var(--color-accent);
    font-weight: 500;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 0.36em 0.65em;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    background: transparent;
    white-space: nowrap;
  }
  .tag--status-unsolved {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-line));
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
  }
  .tag--status-solved {
    color: var(--color-gold);
    border-color: color-mix(in srgb, var(--color-gold) 45%, var(--color-line));
  }
  .tag--status-reading {
    color: var(--color-warn);
    border-color: color-mix(in srgb, var(--color-warn) 45%, var(--color-line));
    background: color-mix(in srgb, var(--color-warn) 8%, transparent);
  }
  .tag--status-user-solved {
    color: var(--color-good);
    border-color: color-mix(in srgb, var(--color-good) 45%, var(--color-line));
    background: color-mix(in srgb, var(--color-good) 8%, transparent);
  }
</style>

<script>
  function updateProgressBadges() {
    document.querySelectorAll<HTMLElement>('[data-case-slug]').forEach((card) => {
      const slug = card.dataset.caseSlug;
      const badge = card.querySelector<HTMLElement>('[data-progress-badge]');
      if (!badge || !slug) return;
      const siteStatus = card.dataset.siteStatus === 'solved' ? 'solved' : 'unsolved';
      try {
        const progress = localStorage.getItem(`inferred:progress:/cases/${slug}`);
        if (progress === 'solved') {
          badge.textContent = '已结案';
          badge.className = 'tag tag--status-user-solved';
        } else if (progress === 'reading') {
          badge.textContent = '推理中';
          badge.className = 'tag tag--status-reading';
        } else if (siteStatus === 'solved') {
          badge.textContent = '已解';
          badge.className = 'tag tag--status-solved';
        } else {
          badge.textContent = '未解';
          badge.className = 'tag tag--status-unsolved';
        }
      } catch (_) {}
    });
  }
  updateProgressBadges();
  window.addEventListener('inferred:case-solved', updateProgressBadges);
</script>
