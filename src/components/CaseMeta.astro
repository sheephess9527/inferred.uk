---
import DifficultyStars from './DifficultyStars.astro';

export interface Props {
  caseId: string;
  slug: string;
  status: 'unsolved' | 'solved';
  difficulty: number;
  types: string[];
  readingTime: string;
  clueCount?: number;
}
const { caseId, slug, status, difficulty, types, readingTime, clueCount } = Astro.props;
const statusCn = status === 'solved' ? '已解' : '未解';
const typeCn = types.join(' · ');
---

<dl class="case-meta">
  <div class="case-meta__row">
    <dt>卷宗编号</dt>
    <dd class="mono">第 {caseId} 号</dd>
  </div>
  <div class="case-meta__row">
    <dt>当前状态</dt>
    <dd data-case-progress data-case-slug={slug} data-site-status={status}>
      <span class:list={['mono', 'case-meta__status', `is-${status}`]} data-case-progress-cn
        >{statusCn}</span
      >
    </dd>
  </div>
  <div class="case-meta__row">
    <dt>推理难度</dt>
    <dd><DifficultyStars value={difficulty} showLabel /></dd>
  </div>
  <div class="case-meta__row">
    <dt>诡计门类</dt>
    <dd>{typeCn}</dd>
  </div>
  <div class="case-meta__row">
    <dt>预计用时</dt>
    <dd class="mono">{readingTime}</dd>
  </div>
  {
    typeof clueCount === 'number' && clueCount > 0 && (
      <div class="case-meta__row">
        <dt>现场物证</dt>
        <dd class="mono">{clueCount} 件</dd>
      </div>
    )
  }
</dl>

<style>
  .case-meta {
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--shadow-card);
  }
  .case-meta__row {
    display: grid;
    grid-template-columns: 5.2rem 1fr;
    gap: var(--space-3);
    padding: 0.42rem 0;
    border-bottom: 1px dashed var(--color-line);
    font-size: 0.9rem;
  }
  .case-meta__row:last-child {
    border-bottom: none;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    align-self: center;
  }
  dd {
    margin: 0;
    align-self: center;
  }
  .case-meta__status {
    font-weight: 600;
  }
  .case-meta__status.is-unsolved {
    color: var(--color-accent);
  }
  .case-meta__status.is-solved {
    color: var(--color-gold);
  }
  .case-meta__status.is-reading {
    color: var(--color-warn);
  }
  .case-meta__status.is-user-solved {
    color: var(--color-good);
  }
</style>

<script>
  function updateCaseProgressBadge(root: HTMLElement) {
    const slug = root.dataset.caseSlug;
    const cn = root.querySelector<HTMLElement>('[data-case-progress-cn]');
    if (!slug || !cn) return;

    const siteSolved = root.dataset.siteStatus === 'solved';
    let progress: string | null = null;
    try {
      progress = localStorage.getItem(`inferred:progress:/cases/${slug}`);
    } catch (_) {}

    if (progress === 'solved') {
      cn.textContent = '已结案';
      cn.className = 'mono case-meta__status is-user-solved';
    } else if (progress === 'reading') {
      cn.textContent = '推理中';
      cn.className = 'mono case-meta__status is-reading';
    } else if (siteSolved) {
      cn.textContent = '已解';
      cn.className = 'mono case-meta__status is-solved';
    } else {
      cn.textContent = '未解';
      cn.className = 'mono case-meta__status is-unsolved';
    }
  }

  document.querySelectorAll<HTMLElement>('[data-case-progress]').forEach(updateCaseProgressBadge);
  window.addEventListener('inferred:case-solved', () => {
    document.querySelectorAll<HTMLElement>('[data-case-progress]').forEach(updateCaseProgressBadge);
  });
</script>
